{
  "name": "dsh-intelligent-ui",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "Replayable sandboxed generative UI for DeepSeek Harness",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./mcp": "./lib/mcp-server.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "dsh": "0.2.1-alpha.4",
    "node": ">=22.19"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-scope": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.4",
    "zod": "4.4.3",
    "@deepseek-ai/schemastery": "3.18.5-alpha.2",
    "@deepseek-ai/dsh-session-controller": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.4",
    "@deepseek-ai/dsh-user-questions": "0.2.1-alpha.4"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "mcp": "node lib/mcp-stdio.js",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "preview": "node scripts/preview.mjs",
    "preview:build": "npm run build",
    "audit:release": "node scripts/audit-release.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "2.0.4",
    "pbf": "4.0.1",
    "@modelcontextprotocol/sdk": "1.31.0",
    "jsdom": "29.1.1",
    "entities": "7.0.1",
    "undici": "8.11.2",
    "zod": "4.4.3"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/jsdom": "28.0.3",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.21.5",
    "playwright": "1.61.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
